<%- include('partials/header', { title }) %>

<main class="content-container">
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>
    <p>Sponsored by: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
    <p><%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> — <%= projectDetails.location %></p>
    <p><%= projectDetails.description %></p>

    <% if (user) { %>
        <% if (isUserVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= projectDetails.project_id %>/unvolunteer" method="POST">
                <button type="submit">Remove Myself as Volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for this Project</button>
            </form>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    <% } %>

    <h3>Categories</h3>
    <ul class="tag-list">
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>